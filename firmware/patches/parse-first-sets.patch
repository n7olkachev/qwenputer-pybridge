+// FIRST sets (first_sets.h, generated from this grammar): skip an alternative, an optional rule
+// or a list item whose rule cannot start with the current token, instead of pushing it, trying
+// it and backtracking. Nullable rules have every bit set, so they are never skipped.
+#include "first_sets.h"
+static inline bool rule_can_start(uint16_t arg, mp_token_kind_t tok) {
+    return (rule_first_table[arg & RULE_ARG_ARG_MASK][tok >> 3] >> (tok & 7)) & 1;
+}
+#define RULE_CAN_START(arg, tok) rule_can_start(arg, tok)
+#else
+#define RULE_CAN_START(arg, tok) (true)
+#endif
